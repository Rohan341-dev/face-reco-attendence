# ---- Core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
POSTGRES_DB=facetrack
POSTGRES_USER=facetrack
POSTGRES_PASSWORD=facetrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- JWT ----
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TOKEN=dev-ai-token-change-me
RECOGNITION_THRESHOLD=0.45
LIVENESS_THRESHOLD=0.70

# ---- Biometric encryption (32-byte key, base64) ----
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
BIOMETRIC_KEY_BASE64=

# ---- Billing (Stripe test keys in dev) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Monitoring ----
SENTRY_DSN=
